        },
        {
          "name": "Checklist Item 7: Successful Cancellation (200 OK)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": { "raw": "{{base_url}}/api/reservations/{{reservation_id}}/cancel/", "host": ["{{base_url}}"], "path": ["api", "reservations", "{{reservation_id}}", "cancel", ""] }
