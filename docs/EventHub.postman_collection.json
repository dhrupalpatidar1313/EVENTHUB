    {
      "name": "4. Reservations (/api/reservations/)",
      "item": [
        {
          "name": "Checklist Item 5: Successful Reservation (201 Created)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var data = pm.response.json();",
                  "if (data.id) {",
                  "    pm.collectionVariables.set(\"reservation_id\", data.id);",
                  "}",
                  "if (data.booking_code) {",
                  "    pm.collectionVariables.set(\"booking_code\", data.booking_code);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event\": {{event_id}},\n  \"attendee_name\": \"Alice Smith\",\n  \"attendee_email\": \"alice@example.com\",\n  \"seats_reserved\": 2\n}"
            },
            "url": { "raw": "{{base_url}}/api/reservations/", "host": ["{{base_url}}"], "path": ["api", "reservations", ""] }
          }
        },
