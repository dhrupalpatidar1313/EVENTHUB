    {
      "name": "3. Events (/api/events/)",
      "item": [
        {
          "name": "List All Events (Public)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/api/events/", "host": ["{{base_url}}"], "path": ["api", "events", ""] }
          }
        },
        {
          "name": "Create Event (Organizer / Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var data = pm.response.json();",
                  "if (data.id) {",
                  "    pm.collectionVariables.set(\"event_id\", data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Global Tech Summit 2026\",\n  \"venue\": \"Bangalore International Exhibition Centre\",\n  \"date\": \"2026-11-20\",\n  \"total_seats\": 100,\n  \"price\": \"299.00\",\n  \"description\": \"Premier technology symposium featuring keynote sessions and interactive workshops.\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/events/", "host": ["{{base_url}}"], "path": ["api", "events", ""] }
          }
        },
        {
          "name": "Retrieve Event (Public)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/api/events/{{event_id}}/", "host": ["{{base_url}}"], "path": ["api", "events", "{{event_id}}", ""] }
          }
        },
        {
          "name": "Filter Events by Status (?status=upcoming)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/events/?status=upcoming",
